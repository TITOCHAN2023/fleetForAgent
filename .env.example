# Copy to .env.local. Preview works without these (in-memory PGLite).
# Production: set a real Postgres URL and Better Auth secret.

# DATABASE_URL=postgres://user:pass@host/db
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://your-domain.example
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# VITE_AUTH_ENABLED=true
