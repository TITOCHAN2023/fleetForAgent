FROM node:20-alpine
WORKDIR /app
COPY packages/fleet-hub ./packages/fleet-hub
COPY packages/fleet-worker/src ./packages/fleet-worker/src
COPY packages/fleet-room ./packages/fleet-room
COPY packages/fleet-tool/operator.mjs \
     packages/fleet-tool/official-plugins.generated.mjs \
     packages/fleet-tool/file-transfer-contract.mjs \
     ./packages/fleet-tool/
WORKDIR /app/packages/fleet-hub
RUN chmod -R a+rX /app
ENV HOST=0.0.0.0 PORT=8787
EXPOSE 8787
USER node
CMD ["node", "index.mjs"]
